rules_version = '2';

// Security rules for the Quản lý tồn kho collections. They re-assert the
// document-level invariants from docs/db_schema.md on the server so a tampered
// client cannot persist inconsistent data. Per-line array checks are enforced
// client-side + by WarehouseReceiptRules in the use case (rules cannot iterate
// an embedded array).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ---- Master data: readable by any signed-in user, writable by admins ----
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /organizations/{id}      { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /departments/{id}        { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /users/{id}             { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /warehouses/{id}         { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /item_categories/{id}    { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /units_of_measure/{id}   { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /items/{id}             { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // ---- Phiếu nhập kho ----
    function receiptValid(d) {
      return d.receiptNumber is string && d.receiptNumber.size() > 0
        && d.organizationId is string && d.organizationId.size() > 0
        && d.warehouseId is string && d.warehouseId.size() > 0
        && d.delivererUserId is string && d.delivererUserId.size() > 0
        && d.attachedDocumentCount is int && d.attachedDocumentCount >= 0
        && d.items is list && d.items.size() > 0 && d.items.size() <= 200
        && d.totalAmount is number && d.totalAmount >= 0
        && exists(/databases/$(database)/documents/warehouses/$(d.warehouseId));
    }

    match /warehouse_receipts/{receiptId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && receiptValid(request.resource.data);
      allow update: if isSignedIn()
        && receiptValid(request.resource.data)
        && request.resource.data.receiptNumber == resource.data.receiptNumber;
      allow delete: if false;
    }

    // Uniqueness mirror — one doc per receiptNumber, created in the same
    // transaction as the receipt.
    match /receipt_numbers/{number} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ---- Tồn kho: written only by the receipt-posting transaction ----
    match /stock_ledger/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // append-only
    }
    match /inventory_stock/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.data.quantityOnHand is number
        && request.resource.data.quantityOnHand >= 0;
    }
  }
}
