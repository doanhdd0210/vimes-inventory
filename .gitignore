# --- Firebase ---
# firebase_options.dart is kept in VCS (it holds no secrets, only public config).
# Platform service files: keep out of a public repo; commit in a private one if
# your team prefers. Uncomment to ignore:
# android/app/google-services.json
# ios/Runner/GoogleService-Info.plist
.firebase/
firebase-debug.log
firestore-debug.log

# --- Env ---
*.env
.env.*
