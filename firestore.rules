rules_version = '2';

// DEMO rules for project vimes-inventory-doanhdd: any signed-in user can read
// and write. This keeps the walkthrough (auto-seed master data, lập phiếu,
// post stock) friction-free. Tighten before any real use — the per-collection
// / role-based version is preserved below.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

