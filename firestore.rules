rules_version = '2';

// Security rules for the Phiếu nhập kho collections. These re-assert the
// integrity constraints from docs/db_schema.md on the server so a tampered
// client cannot write inconsistent data.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Firestore rules cannot iterate an embedded array, so per-line checks
    // (name/unit non-empty, quantityActual > 0, amount == qty * price) are
    // enforced client-side and by WarehouseReceiptRules in the use case. The
    // rules below guard the document-level invariants.
    function receiptValid(d) {
      return d.receiptNumber is string && d.receiptNumber.size() > 0
        && d.delivererName is string && d.delivererName.size() > 0
        && d.warehouseName is string && d.warehouseName.size() > 0
        && d.attachedDocumentCount is int && d.attachedDocumentCount >= 0
        && d.items is list && d.items.size() > 0
        && d.totalAmount is number && d.totalAmount >= 0;
    }

    match /warehouse_receipts/{receiptId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && receiptValid(request.resource.data)
        && request.resource.data.items.size() <= 200;
      allow update: if isSignedIn()
        && receiptValid(request.resource.data)
        // block edits to a posted receipt's number
        && request.resource.data.receiptNumber == resource.data.receiptNumber;
      allow delete: if false;
    }

    // Uniqueness mirror — one doc per receiptNumber, created in the same
    // transaction as the receipt.
    match /receipt_numbers/{number} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
